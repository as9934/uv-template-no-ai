{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sync Python environment",
            "type": "process",
            "command": "uv",
            "args": ["sync", "--locked", "--inexact"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
